{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doubleone.dev/schemas/dd-skill-contract.schema.json",
  "title": "DD Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "version",
    "type",
    "purpose",
    "trigger",
    "non_trigger",
    "inputs",
    "outputs",
    "required_tools",
    "allowed_permissions",
    "risk_level",
    "human_gate",
    "success_criteria",
    "rollback",
    "stop_condition",
    "known_limitations",
    "supported_platforms"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "const": "Skill"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "non_trigger": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "human_gate": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_platforms": {
      "type": "array",
      "items": {
        "enum": [
          "Codex",
          "Claude",
          "Gemini",
          "Generic"
        ]
      },
      "minItems": 1
    }
  }
}