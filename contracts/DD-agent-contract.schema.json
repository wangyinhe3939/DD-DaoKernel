{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doubleone.dev/schemas/dd-agent-contract.schema.json",
  "title": "DD Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "version",
    "type",
    "responsibility",
    "authority",
    "forbidden_authority",
    "state",
    "handoff",
    "skills",
    "tools",
    "risk_level",
    "human_gate",
    "success_criteria",
    "rollback",
    "stop_condition",
    "vetoed_by",
    "supported_platforms"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "const": "Agent"
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_authority": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "state": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "human_gate": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "stop_condition": {
      "type": "string",
      "minLength": 1
    },
    "vetoed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_platforms": {
      "type": "array",
      "items": {
        "enum": [
          "Codex",
          "Claude",
          "Gemini",
          "Generic"
        ]
      },
      "minItems": 1
    }
  }
}